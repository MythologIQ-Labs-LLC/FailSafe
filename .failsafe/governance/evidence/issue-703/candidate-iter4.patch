index 00000000..aa41b6d2
--- /dev/null
+++ b/FailSafe/extension/src/test/roadmap/delivery-assessment-renderer.review.test.ts
@@ -0,0 +1,242 @@
+// #703: the Delivery review form across repaints. The operator's picked commit, rework picks and
+// unsent note survive a refresh; a note belongs to one intent and commit; a newer edit is never
+// erased by an older POST; PASS and VETO cannot both be submitted; a failed POST allows a retry.
+// Pending requests are held with explicit promise gates, never sleeps.
+
+import { strict as assert } from 'assert';
+// @ts-expect-error untyped JS module
+import { DeliveryAssessmentRenderer } from '../../../src/roadmap/ui/modules/delivery-assessment-renderer.js';
+import { ACTIVE, SEALED, SHA, SHA2, fire, fx, holdPosts, resetFixture, settled, setupDom } from './deliveryRendererFixture';
+
+const REVIEW = '/api/actions/delivery/review';
+const SHA3 = '7'.repeat(40);
+const q = <T extends Element>(doc: Document, selector: string) => doc.querySelector(selector) as T;
+const typeNote = (doc: Document, text: string) => {
+  const note = q<HTMLInputElement>(doc, '.cc-dlv-review-note');
+  note.value = text;
+  fire(doc, note, 'input');
+  return note;
+};
+const pick = (doc: Document, selector: string, value: string) => {
+  const select = q<HTMLSelectElement>(doc, selector);
+  select.value = value;
+  fire(doc, select, 'change');
