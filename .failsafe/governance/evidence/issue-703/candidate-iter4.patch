diff --git a/FailSafe/extension/src/roadmap/ui/modules/delivery-dom.js b/FailSafe/extension/src/roadmap/ui/modules/delivery-dom.js
new file mode 100644
index 00000000..d53caa15
--- /dev/null
+++ b/FailSafe/extension/src/roadmap/ui/modules/delivery-dom.js
@@ -0,0 +1,15 @@
+/** DOM helpers shared by the Workspace "Delivery" sub-view modules. Text is set with textContent, never as HTML. */
+
+export function el(tag, cls, text) {
+  const node = document.createElement(tag);
+  if (cls) node.className = cls;
+  if (text !== undefined && text !== null) node.textContent = String(text);
+  return node;
+}
+
+export function button(label, cls, onClick) {
+  const b = el('button', `cc-dlv-btn${cls ? ` ${cls}` : ''}`, label);
+  b.type = 'button';
+  b.addEventListener('click', onClick);
+  return b;
+}
diff --git a/FailSafe/extension/src/roadmap/ui/modules/delivery-review-controls.js b/FailSafe/extension/src/roadmap/ui/modules/delivery-review-controls.js
new file mode 100644
index 00000000..e4756b17
--- /dev/null
+++ b/FailSafe/extension/src/roadmap/ui/modules/delivery-review-controls.js
@@ -0,0 +1,113 @@
+/**
+ * Delivery review controls (plan-b320 LD9, #703): Record PASS / Record VETO on one linked commit of
+ * the active intent, with a note and (B344) a "Reworked by" pick per trusted VETO.
+ *
+ * #703: the Delivery panel is repainted by refreshes the operator does not control, so the review
+ * form is kept on the renderer, never in the DOM: the picked commit and rework picks per intent
+ * (`reviewForm`), and the unsent note per intent and commit (`reviewNoteDraft`). Only one review
+ * request is in flight at a time (`reviewInFlight`), so PASS and VETO cannot race into
+ * contradictory submissions. The server's review lock remains the authority (FX1010).
+ */
+import { el, button } from './delivery-dom.js';
+
+function linkedOption(e) {
+  const opt = el('option', null, `${e.target.slice(0, 12)} linked ${e.linkedAt}`);
+  opt.value = e.target;
+  return opt;
+}
+
+/** The commit to review: the operator's earlier pick on this intent while still linked, else the newest. */
+function commitPick(linked, form) {
+  const select = el('select', 'cc-dlv-select cc-dlv-review-pick');
+  select.setAttribute('aria-label', 'Commit to review');
+  for (const e of linked) select.appendChild(linkedOption(e));
+  select.selectedIndex = linked.length - 1;
+  if (form && linked.some((e) => e.target === form.commitSha)) select.value = form.commitSha;
+  return select;
+}
+
+/** The note input, showing the unsent draft for this intent and the picked commit only. */
+function noteInput(renderer, intentId, select) {
+  const note = el('input', 'cc-dlv-select cc-dlv-review-note');
+  note.type = 'text';
+  note.maxLength = 500;
+  note.placeholder = 'Note (optional)';
+  note.setAttribute('aria-label', 'Review note');
+  const restore = () => {
+    const draft = renderer.reviewNoteDraft;
+    note.value = draft && draft.intentId === intentId && draft.commitSha === select.value ? draft.value : '';
+  };
+  restore();
+  note.addEventListener('input', () => {
+    renderer.reviewNoteDraft = { intentId, commitSha: select.value, value: note.value };
+  });
+  select.addEventListener('change', restore);
+  return note;
+}
+
+/**
+ * #532 B344 (plan-b344 LD5): a "Reworked by" select on each blocking trusted VETO (a sealed row's
+ * commit): none, or a linked commit other than the vetoed one. The server verifies the relation.
+ */
+function reworkPicks(view, linked, form) {
+  const step = ((view.assessment && view.assessment.steps) || []).find((s) => s.key === 'review');
+  const vetoes = ((step && step.records) || []).filter((r) => r.record === 'blocking' && r.kind === 'veto' && r.commitState === 'sealed' && r.commitSha);
+  return vetoes.map((r) => {
+    const wrap = el('label', 'cc-dlv-line cc-dlv-rework', `Reworked by (VETO #${r.id} on ${String(r.commitSha).slice(0, 12)}): `);
+    const pick = el('select', 'cc-dlv-select cc-dlv-rework-pick');
+    pick.setAttribute('data-veto', String(r.id));
+    pick.setAttribute('aria-label', `Linked commit that reworks the VETO in ledger entry #${r.id}`);
+    const none = el('option', null, 'none');
+    none.value = '';
+    pick.appendChild(none);
+    const kept = form ? form.reworks[String(r.id)] : '';
+    for (const e of linked.filter((x) => x.target !== r.commitSha)) {
+      const opt = linkedOption(e);
+      opt.selected = opt.value === kept;
+      pick.appendChild(opt);
+    }
+    wrap.appendChild(pick);
+    return pick;
+  });
+}
+
+/** PASS and VETO: one review request at a time, across repaints. */
+function reviewButtons(renderer, intentId, select, note, reworksOf) {
+  const record = (verdict) => {
+    if (renderer.reviewInFlight) return;
+    renderer.reviewInFlight = true;
+    pass.disabled = true;
+    veto.disabled = true;
+    void renderer.review(intentId, verdict, select.value, note.value, verdict === 'PASS' ? reworksOf() : []);
+  };
+  const pass = button('Record PASS', 'cc-dlv-review-pass', () => record('PASS'));
+  const veto = button('Record VETO', 'cc-dlv-btn-link cc-dlv-review-veto', () => record('VETO'));
+  pass.disabled = renderer.reviewInFlight;
+  veto.disabled = renderer.reviewInFlight;
+  return [pass, veto];
+}
+
+/** plan-b320 LD9: the review controls for the active intent's view. */
+export function reviewControls(renderer, view) {
+  const actions = el('div', 'cc-dlv-actions cc-dlv-review-actions');
+  const linked = view.edges.filter((e) => e.edge === 'committed-under');
+  if (!linked.length) {
+    actions.appendChild(el('span', 'cc-dlv-line', 'Link a commit first; a review is recorded on one linked commit.'));
+    return actions;
+  }
+  const intentId = view.intent.id;
+  const form = renderer.reviewForm && renderer.reviewForm.intentId === intentId ? renderer.reviewForm : null;
+  const select = commitPick(linked, form);
+  const note = noteInput(renderer, intentId, select);
+  const picks = reworkPicks(view, linked, form);
+  const remember = () => {
+    renderer.reviewForm = { intentId, commitSha: select.value, reworks: Object.fromEntries(picks.map((p) => [p.getAttribute('data-veto'), p.value])) };
+  };
+  for (const control of [select, ...picks]) control.addEventListener('change', remember);
+  actions.appendChild(select);
+  actions.appendChild(note);
+  for (const pick of picks) actions.appendChild(pick.parentNode);
+  const reworksOf = () => picks.filter((p) => p.value).map((p) => ({ vetoEntryId: Number(p.getAttribute('data-veto')), reworkCommit: p.value }));
+  for (const b of reviewButtons(renderer, intentId, select, note, reworksOf)) actions.appendChild(b);
+  return actions;
+}
diff --git a/FailSafe/extension/src/test/roadmap/delivery-assessment-renderer.refresh.test.ts b/FailSafe/extension/src/test/roadmap/delivery-assessment-renderer.refresh.test.ts
new file mode 100644
index 00000000..a9a5ad1d
--- /dev/null
+++ b/FailSafe/extension/src/test/roadmap/delivery-assessment-renderer.refresh.test.ts
@@ -0,0 +1,141 @@
+// #703: overlapping refreshes and late operation results in the Workspace "Delivery" sub-view.
+// An older GET (listing, detail, candidates, or a failure) must not change the selection, repaint
+// a newer view or keep fetching; a late review or link result is shown only on the intent that
+// initiated it, once. Each case suspends one request with an explicit promise gate, never a sleep.
+
+import { strict as assert } from 'assert';
+// @ts-expect-error untyped JS module
+import { DeliveryAssessmentRenderer } from '../../../src/roadmap/ui/modules/delivery-assessment-renderer.js';
+import { ACTIVE, SEALED, holdFirstGet, holdPosts, resetFixture, settled, setupDom } from './deliveryRendererFixture';
+
+const DETAIL = `/api/v1/delivery/intents/${ACTIVE}`;
+const REVIEW = '/api/actions/delivery/review';
+const LINK = '/api/actions/delivery/link';
+const click = (doc: Document, selector: string) => (doc.querySelector(selector) as HTMLButtonElement).click();
+
+// Each case starts an operation on ACTIVE and views SEALED while it is pending; `expected` is the
+// completion text then shown once on ACTIVE.
+const LATE_RESULTS = [
+  { name: 'successful review POST', url: REVIEW, fail: 'none', method: 'review', button: '.cc-dlv-review-pass', expected: /Review PASS recorded/ },
+  { name: 'failed review POST', url: REVIEW, fail: 'network', method: 'review', button: '.cc-dlv-review-pass', expected: /Recording the review failed: late network failure/ },
+  { name: 'refused review POST', url: REVIEW, fail: 'http', method: 'review', button: '.cc-dlv-review-pass', expected: /late refusal/ },
+  { name: 'successful link POST', url: LINK, fail: 'none', method: 'post', button: '.cc-dlv-link-arch', expected: /Link recorded in the intent history/ },
+  { name: 'refused link POST', url: LINK, fail: 'http', method: 'post', button: '.cc-dlv-link-arch', expected: /late refusal/ },
+] as const;
+
+suite('DeliveryAssessmentRenderer stale refresh and result attribution (#703, jsdom)', () => {
+  setup(() => resetFixture());
+
+  test('#703: a stale listing response neither repaints nor fetches the details it would have chosen', async () => {
+    const ctx = setupDom();
+    const hold = holdFirstGet('/api/v1/delivery/intents');
+    try {
+      const renderer = new DeliveryAssessmentRenderer('workspace');
+      const earlier = renderer.refresh();
+      await hold.started;
+      renderer.selectedId = SEALED;
+      await renderer.refresh();
+      const panel = ctx.doc.querySelector('.cc-dlv');
+      const fetchedBefore = ctx.fetched.length;
+      hold.release();
+      await earlier;
+      assert.equal(ctx.doc.querySelector('.cc-dlv'), panel);
+      assert.equal(renderer.selectedId, SEALED);
+      assert.deepEqual(ctx.fetched.slice(fetchedBefore), ['/api/v1/delivery/intents'],
+        'only the held listing completes; an obsolete refresh must stop at its first stale response');
+    } finally { hold.release(); ctx.cleanup(); }
+  });
+
+  test('#703: a stale detail response cannot repaint a newer selected intent', async () => {
+    const ctx = setupDom();
+    const hold = holdFirstGet(DETAIL);
+    try {
+      const renderer = new DeliveryAssessmentRenderer('workspace');
+      const earlier = renderer.refresh();
+      await hold.started;
+      renderer.selectedId = SEALED; // Operator chose another intent while the detail GET was pending.
+      await renderer.refresh();
+      const currentPanel = ctx.doc.querySelector('.cc-dlv');
+      assert.ok(currentPanel, 'the newly chosen intent must render');
+      assert.match(currentPanel.textContent || '', /PROJ-6/);
+      assert.equal(ctx.doc.querySelector('.cc-dlv-review-pass'), null, 'sealed intent cannot be reviewed');
+      const fetchedBefore = ctx.fetched.length;
+      hold.release();
+      await earlier;
+      assert.equal(ctx.doc.querySelector('.cc-dlv'), currentPanel,
+        'an older response must not replace the newer selected view');
+      assert.equal(renderer.selectedId, SEALED);
+      assert.equal(ctx.doc.querySelector('.cc-dlv-review-pass'), null);
+      assert.deepEqual(ctx.fetched.slice(fetchedBefore), [DETAIL], 'only the held detail completes; it must not fetch candidates');
+    } finally { hold.release(); ctx.cleanup(); }
+  });
+
+  test('#703: delayed candidates from a previous intent cannot overwrite the newly selected view', async () => {
+    const ctx = setupDom();
+    const hold = holdFirstGet('/api/v1/delivery/candidates');
+    try {
+      const renderer = new DeliveryAssessmentRenderer('workspace');
+      const earlier = renderer.refresh();
+      await hold.started;
+      renderer.selectedId = SEALED;
+      await renderer.refresh();
+      const newPanel = ctx.doc.querySelector('.cc-dlv');
+      assert.ok(newPanel);
+      assert.match(newPanel.textContent || '', /PROJ-6/);
+      hold.release();
+      await earlier;
+      assert.equal(ctx.doc.querySelector('.cc-dlv'), newPanel, 'stale candidates must not repaint');
+      assert.equal(renderer.selectedId, SEALED);
+      assert.equal(ctx.doc.querySelector('.cc-dlv-review-pass'), null);
+    } finally { hold.release(); ctx.cleanup(); }
+  });
+
+  test('#703: an old failed GET must not overwrite a later successful Delivery view', async () => {
+    const ctx = setupDom();
+    const hold = holdFirstGet('/api/v1/delivery/intents', 'stale transport failure');
+    try {
+      const renderer = new DeliveryAssessmentRenderer('workspace');
+      const earlier = renderer.refresh();
+      await hold.started;
+      await renderer.refresh();
+      const currentPanel = ctx.doc.querySelector('.cc-dlv');
+      assert.ok(currentPanel);
+      assert.match(currentPanel.textContent || '', /PROJ-7/);
+      hold.release();
+      await earlier;
+      assert.equal(ctx.doc.querySelector('.cc-dlv'), currentPanel);
+      assert.doesNotMatch(ctx.doc.querySelector('.cc-dlv')?.textContent || '', /stale transport failure/);
+    } finally { hold.release(); ctx.cleanup(); }
+  });
+
+  for (const c of LATE_RESULTS) {
+    test(`#703: a ${c.name} does not display its result on another intent`, async () => {
+      const ctx = setupDom();
+      const hold = holdPosts(c.url, c.fail);
+      try {
+        const renderer = new DeliveryAssessmentRenderer('workspace');
+        const finished = settled(renderer, c.method);
+        await renderer.refresh();
+        click(ctx.doc, c.button);
+        assert.ok(hold.held(), 'the operation must still be pending');
+        renderer.selectedId = SEALED; // A different intent becomes visible while the POST is pending.
+        await renderer.refresh();
+        assert.match(ctx.doc.querySelector('.cc-dlv')?.textContent || '', /PROJ-6/);
+        hold.release();
+        await finished();
+        assert.equal(renderer.selectedId, SEALED);
+        assert.equal(ctx.doc.querySelector('.cc-dlv-result'), null,
+          'an older intent operation must not be reported as this sealed intent result');
+        assert.match(ctx.doc.querySelector('.cc-dlv')?.textContent || '', /PROJ-6/);
+        renderer.selectedId = ACTIVE;
+        await renderer.refresh();
+        assert.match(ctx.doc.querySelector('.cc-dlv-result')?.textContent || '', c.expected);
+        assert.equal(ctx.doc.querySelectorAll('.cc-dlv-result').length, 1,
+          'completion may be displayed once, only on its initiating intent');
+        await renderer.refresh();
+        assert.equal(ctx.doc.querySelector('.cc-dlv-result'), null,
+          'a consumed completion message may not replay on another refresh');
+      } finally { hold.release(); ctx.cleanup(); }
+    });
+  }
+});
diff --git a/FailSafe/extension/src/test/roadmap/delivery-assessment-renderer.review.test.ts b/FailSafe/extension/src/test/roadmap/delivery-assessment-renderer.review.test.ts
