@@ -24,7 +24,10 @@ export function validateDueDate(dueDate: string | undefined): string | undefined
   if (!/^\d{4}-\d{2}-\d{2}$/.test(dueDate)) throw new ValidationError(`due date "${dueDate}" is not YYYY-MM-DD`);
   const parsed = new Date(`${dueDate}T00:00:00Z`);
   if (Number.isNaN(parsed.getTime())) throw new ValidationError(`due date "${dueDate}" is not a date`);
-  return parsed.toISOString().slice(0, 10);
+  // TASK-14: Date rolls impossible days forward (2026-02-30 -> 2026-03-02); reject them instead.
+  const canonical = parsed.toISOString().slice(0, 10);
+  if (canonical !== dueDate) throw new ValidationError(`due date "${dueDate}" does not exist`);
+  return canonical;
 }
 
